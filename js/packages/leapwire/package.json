{
  "name": "leapwire",
  "version": "0.1.0",
  "description": "Remove request waterfalls without changing application code: a fetch wrapper that reads the bundles a Leapwire Spring Boot backend streams and answers the follow-up GET requests from them.",
  "license": "Apache-2.0",
  "author": "Dharaneesh S (https://github.com/DHARANEESH-SRINIVASAN)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DHARANEESH-SRINIVASAN/leapwire.git",
    "directory": "js/packages/leapwire"
  },
  "homepage": "https://github.com/DHARANEESH-SRINIVASAN/leapwire#readme",
  "bugs": "https://github.com/DHARANEESH-SRINIVASAN/leapwire/issues",
  "keywords": [
    "fetch",
    "waterfall",
    "prefetch",
    "bundle",
    "spring-boot",
    "react-native",
    "ndjson",
    "streaming",
    "performance"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "axios": "1.21.0",
    "fast-check": "4.10.2",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
